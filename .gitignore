# Nix build outputs
result
result-*
.nix-eval-cache

# mdbook build output (docs/src is tracked, docs/book is generated)
docs/book/

# direnv
.direnv/
.envrc.local

# Written into the working tree by the git-hooks shellHook on `nix develop`.
# The hook definitions live in flake/dev-shells.nix.
.pre-commit-config.yaml

# Editor scratch files
*.swp
*.swo
*~
.\#*
\#*\#

# Belt and suspenders. This repository must never contain key material at all,
# and these patterns are here so a stray file cannot be committed by accident
# rather than because anything is expected to match them.
*.key
*-key.txt
*.asc
.age-key
