# ============================================================================
# NIX BUILD ARTIFACTS
# ============================================================================

# Nix build results
result
result-*
result-bin

# VM build artifacts
*.qcow2
run-*-vm

# Nix evaluation cache
.nix-eval-cache

# ============================================================================
# HARDWARE CONFIGURATION
# ============================================================================

# Hardware configuration (contains system-specific information)
# Uncomment if you don't want to track hardware configs
# hosts/*/hardware-configuration.nix

# Hardware info collected for testing
hardware-info/

# ============================================================================
# SECRETS MANAGEMENT
# ============================================================================

# IMPORTANT: Only ignore unencrypted secrets and private keys
# SOPS-encrypted .yaml files should be committed to git

# Private keys
*.key         # Private age/GPG keys
*-key.txt     # Age key files
*.asc         # ASCII armored keys
.age-key      # Age key directory
.gnupg/       # Local GPG directory

# SOPS runtime files
.sops.yaml.tmp
.decrypted~*

# Age keys in /var/lib/sops-nix (if accidentally copied)
desktop-key.txt
laptop-key.txt

# Allow encrypted secrets (managed by SOPS)
!secrets/
!secrets/**/*.yaml
!secrets/.gitkeep
!secrets/README.md

# But ignore any unencrypted secrets (just in case)
secrets/**/*.dec.yaml
secrets/**/*.decrypted.*
secrets/**/*.plain.*
*.unencrypted.yaml

# ============================================================================
# EDITOR AND IDE FILES
# ============================================================================

# VSCode
.vscode/
*.code-workspace

# JetBrains (IntelliJ, PyCharm, etc.)
.idea/
*.iml

# Vim/Neovim
*.swp
*.swo
*.swn
*~
.*.sw?
Session.vim
.netrwhist

# Emacs
*~
\#*\#
.\#*
.projectile

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================================================
# OS-SPECIFIC FILES
# ============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Linux
.directory
.Trash-*

# ============================================================================
# TEMPORARY AND BACKUP FILES
# ============================================================================

# Backup files
*.bak
*.backup
*.old
*.orig
*.tmp

# Log files
*.log

# Direnv (automatic environment loading for dev shells)
.direnv/
.envrc.local

# ============================================================================
# NIX-SPECIFIC DEVELOPMENT
# ============================================================================

# Nix shell environment
shell.nix.local

# Cachix
.cachix/

# Pre-commit hooks
# Generated by git-hooks.nix (a symlink into /nix/store), regenerated per
# machine on `nix develop`/`just`, so it must not be tracked.
.pre-commit-config.yaml
.pre-commit-config.yaml.backup

# ============================================================================
# PROJECT-SPECIFIC
# ============================================================================

# Testing scripts output
test-output/
build-logs/

# Documentation builds (if using mdbook, etc.)
book/


# Claude Code, whose declarative config lives in modules/apps/cli/ai/ (settings +
# MCP servers via programs.claude-code/programs.mcp). These are per-machine,
# runtime-mutated files, not a source of truth:
#   - settings.local.json: personal permission overrides Claude Code writes itself
#   - .mcp.json: would be an unpinned duplicate of the home-manager MCP plugin
.claude/settings.local.json
.mcp.json

# ============================================================================
# WALLPAPERS
# ============================================================================

# User-specific wallpapers (users add their own)
# The default placeholder wallpaper.png is tracked, but users can replace it
wallpapers/*.jpg
wallpapers/*.jpeg
wallpapers/*.webp

# Allow README, .gitkeep, and default wallpaper.png
!wallpapers/README.md
!wallpapers/.gitkeep
!wallpapers/wallpaper.png

# Generated by flake/docs-options.nix (just docs build / nix build .#options-doc)
docs/src/reference/options.md
